<Window x:Class="DashRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DashRL"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#0C0E12"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>


    <Window.Resources>

        <!-- ======================================================== -->
        <!-- SCROLLBAR -->
        <!-- ======================================================== -->

        <Style x:Key="ModernScrollThumb"
               TargetType="Thumb">

            <Setter Property="Width"
                    Value="4"/>

            <Setter Property="MinHeight"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#343946"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Thumb">

                        <Border x:Name="Thumb"
                                Width="4"
                                Margin="0,3"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Thumb"
                                        Property="Width"
                                        Value="6"/>

                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#596174"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter TargetName="Thumb"
                                        Property="Width"
                                        Value="6"/>

                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#7C6CFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="10"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.DecreaseRepeatButton>


                                <Track.Thumb>

                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>

                                </Track.Thumb>


                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ======================================================== -->
        <!-- NAVIGATION -->
        <!-- ======================================================== -->

        <Style x:Key="MenuButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Foreground"
                    Value="#858B99"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <Grid>

                                <Border x:Name="Indicator"
                                        Width="3"
                                        Height="18"
                                        Margin="0,0,0,0"
                                        Background="#7C6CFF"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Opacity="0"/>

                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#171A22"/>

                                <Setter Property="Foreground"
                                        Value="#F1F2F5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ======================================================== -->
        <!-- PRIMARY BUTTON -->
        <!-- ======================================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#7164E8"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#8073F5"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#6559D3"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ======================================================== -->
        <!-- OVERLAY PRESET -->
        <!-- ======================================================== -->

        <Style x:Key="PresetButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="78"/>

            <Setter Property="Margin"
                    Value="0,0,10,0"/>

            <Setter Property="Padding"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="#F2F3F6"/>

            <Setter Property="Background"
                    Value="#13161D"/>

            <Setter Property="BorderBrush"
                    Value="#222630"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="PresetBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="PresetBorder"
                                        Property="Background"
                                        Value="#181B24"/>

                                <Setter TargetName="PresetBorder"
                                        Property="BorderBrush"
                                        Value="#363B49"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ======================================================== -->
        <!-- WINDOW BUTTONS -->
        <!-- ======================================================== -->

        <Style x:Key="WindowButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="46"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Foreground"
                    Value="#8F95A3"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Background"
                                        Property="Background"
                                        Value="#191C24"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="CloseWindowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowButtonStyle}">

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Background"
                                Background="Transparent">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Background"
                                        Property="Background"
                                        Value="#D93B4A"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ======================================================== -->
        <!-- STAT CARD -->
        <!-- ======================================================== -->

        <Style x:Key="StatCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#11141B"/>

            <Setter Property="BorderBrush"
                    Value="#1D212B"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================ -->
    <!-- ROOT -->
    <!-- ============================================================ -->

    <Border Background="#0A0C11"
            BorderBrush="#1C2029"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ==================================================== -->
            <!-- TITLE BAR -->
            <!-- ==================================================== -->

            <Border Grid.Row="0"
                    Background="#0D0F14"
                    BorderBrush="#1A1E26"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">

                        <Border Width="20"
                                Height="20"
                                Background="#7164E8"
                                CornerRadius="5">

                            <TextBlock Text="D"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="DashRL"
                                   Foreground="#E8E9ED"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>


                    <StackPanel Grid.Column="2"
            Orientation="Horizontal">

    <!-- RÉDUIRE -->
    <Button Style="{StaticResource WindowButtonStyle}"
            ToolTip="Réduire"
            Click="MinimizeButton_Click">

        <Grid Width="16"
              Height="16">

            <Path Data="M3,8 L13,8"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

        </Grid>

    </Button>


    <!-- AGRANDIR / RESTAURER -->
<Button x:Name="MaximizeButton"
        Style="{StaticResource WindowButtonStyle}"
        ToolTip="Agrandir / Restaurer"
        Click="MaximizeButton_Click">

    <Viewbox Width="15"
             Height="15">

        <Canvas Width="24"
                Height="24">

            <!-- Coin haut gauche -->
            <Path Data="M9,3 L3,3 L3,9"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>

            <!-- Coin haut droit -->
            <Path Data="M15,3 L21,3 L21,9"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>

            <!-- Coin bas gauche -->
            <Path Data="M3,15 L3,21 L9,21"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>

            <!-- Coin bas droit -->
            <Path Data="M21,15 L21,21 L15,21"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>

        </Canvas>

    </Viewbox>

</Button>


    <!-- FERMER -->
    <Button Style="{StaticResource CloseWindowButtonStyle}"
            ToolTip="Fermer"
            Click="CloseButton_Click">

        <Grid Width="16"
              Height="16">

            <Path Data="M4,4 L12,12 M12,4 L4,12"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

        </Grid>

    </Button>

</StackPanel>

                </Grid>

            </Border>


            <!-- ==================================================== -->
            <!-- APPLICATION -->
            <!-- ==================================================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- SIDEBAR -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="#0D0F14"
                        BorderBrush="#1A1E26"
                        BorderThickness="0,0,1,0">

                    <Grid Margin="16,24,16,18">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0"
                                    Margin="10,0,0,0">

                            <TextBlock Text="MENU"
                                       Foreground="#515866"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                        </StackPanel>


                        <StackPanel Grid.Row="2">

                            <Button x:Name="DashboardButton"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Click="DashboardButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Margin="0,0,11,0" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round"
                                          Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z"/>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="OverlayButton"
                                    Style="{StaticResource MenuButtonStyle}"
                                    Click="OverlayButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Margin="0,0,11,0" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          Data="M4,4 L20,4 L20,16 L4,16 Z M8,20 L16,20 M12,16 L12,20"/>
                                    <TextBlock Text="Overlay" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Margin="0,0,11,0" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,20 L4,14 M10,20 L10,9 M16,20 L16,4 M22,20 L2,20"/>
                                    <TextBlock Text="Statistiques" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MenuButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Margin="0,0,11,0" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" StrokeLineJoin="Round"
                                          Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M19.4,15 A1.7,1.7 0 0 0 19.7,16.9 L19.8,17 A2,2 0 0 1 17,19.8 L16.9,19.7 A1.7,1.7 0 0 0 15,19.4 A1.7,1.7 0 0 0 14,21 L14,21.1 A2,2 0 0 1 10,21.1 L10,21 A1.7,1.7 0 0 0 9,19.4 A1.7,1.7 0 0 0 7.1,19.7 L7,19.8 A2,2 0 0 1 4.2,17 L4.3,16.9 A1.7,1.7 0 0 0 4.6,15 A1.7,1.7 0 0 0 3,14 L2.9,14 A2,2 0 0 1 2.9,10 L3,10 A1.7,1.7 0 0 0 4.6,9 A1.7,1.7 0 0 0 4.3,7.1 L4.2,7 A2,2 0 0 1 7,4.2 L7.1,4.3 A1.7,1.7 0 0 0 9,4.6 A1.7,1.7 0 0 0 10,3 L10,2.9 A2,2 0 0 1 14,2.9 L14,3 A1.7,1.7 0 0 0 15,4.6 A1.7,1.7 0 0 0 16.9,4.3 L17,4.2 A2,2 0 0 1 19.8,7 L19.7,7.1 A1.7,1.7 0 0 0 19.4,9 A1.7,1.7 0 0 0 21,10 L21.1,10 A2,2 0 0 1 21.1,14 L21,14 A1.7,1.7 0 0 0 19.4,15 Z"/>
                                    <TextBlock Text="Paramètres" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>


                        <!-- CONNECTION -->

                        <Border Grid.Row="3"
                                Background="#10131A"
                                BorderBrush="#1D222B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="13">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <Border Width="8"
                                        Height="8"
                                        Background="#58C985"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>


                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="Rocket League"
                                               Foreground="#E2E4E9"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="ConnectionStatus"
                                               Text="Connexion..."
                                               Foreground="#6F7685"
                                               FontSize="11"
                                               Margin="0,2,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- CONTENT -->
                <!-- ================================================= -->

                <Grid Grid.Column="1"
                      Background="#0A0C11">


                    <!-- ================================================= -->
                    <!-- DASHBOARD -->
                    <!-- ================================================= -->

                    <ScrollViewer x:Name="DashboardPage"
                                  Visibility="Visible"
                                  Background="#0A0C11"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="38,32,30,40">


                            <!-- HEADER -->

                            <StackPanel Margin="0,0,0,30">

                                <TextBlock Text="Dashboard"
                                           Foreground="#F4F5F7"
                                           FontSize="28"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Vue d'ensemble de ta session Rocket League"
                                           Foreground="#6F7685"
                                           FontSize="13"
                                           Margin="0,6,0,0"/>

                            </StackPanel>


                            <!-- MATCH -->

                            <Border Background="#10131A"
                                    BorderBrush="#1D222B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="28"
                                    Margin="0,0,0,28">

                                <StackPanel>

                                    <TextBlock Text="MATCH EN COURS"
                                               Foreground="#5E6573"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,20"/>


                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Border Width="8"
                                                    Height="8"
                                                    Background="#4A9EFF"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,9"/>

                                            <TextBlock x:Name="BlueTeamName"
                                                       Text="BLEU"
                                                       Foreground="#E9EAED"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"/>

                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Center">

                                            <TextBlock x:Name="ScoreText"
                                                       Text="0 : 0"
                                                       Foreground="White"
                                                       FontSize="42"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>

                                            <Border Background="#171A22"
                                                    CornerRadius="5"
                                                    Padding="10,4"
                                                    Margin="0,7,0,0"
                                                    HorizontalAlignment="Center">

                                                <TextBlock x:Name="TimeText"
                                                           Text="00:00"
                                                           Foreground="#8E95A4"
                                                           FontSize="12"/>

                                            </Border>

                                        </StackPanel>


                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                            <Border Width="8"
                                                    Height="8"
                                                    Background="#FF8A3D"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,9"/>

                                            <TextBlock x:Name="OrangeTeamName"
                                                       Text="ORANGE"
                                                       Foreground="#E9EAED"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"/>

                                        </StackPanel>

                                    </Grid>

                                </StackPanel>

                            </Border>


                            <!-- SESSION TITLE -->

                            <TextBlock Text="Session"
                                       Foreground="#E9EAED"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,13"/>


                            <!-- SESSION CARDS -->

                            <UniformGrid Columns="3"
                                         Margin="0,0,0,28">


                                <Border Style="{StaticResource StatCardStyle}"
                                        Margin="0,0,10,0">

                                    <StackPanel>

                                        <TextBlock Text="VICTOIRES"
                                                   Foreground="#656C7B"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="SessionWins"
                                                   Text="0"
                                                   Foreground="#F1F2F5"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

                                        <TextBlock Text="Matchs gagnés"
                                                   Foreground="#515866"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>

                                    </StackPanel>

                                </Border>


                                <Border Style="{StaticResource StatCardStyle}"
                                        Margin="5,0">

                                    <StackPanel>

                                        <TextBlock Text="DÉFAITES"
                                                   Foreground="#656C7B"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="SessionLosses"
                                                   Text="0"
                                                   Foreground="#F1F2F5"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Margin="0,8,0,0"/>

