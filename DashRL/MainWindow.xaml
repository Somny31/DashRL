                            <TextBlock Text="Cards"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Blocs séparés"
                                       Foreground="#737A89"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Button>


