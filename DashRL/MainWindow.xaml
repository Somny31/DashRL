<Window x:Class="DashRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashRL"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F14">

    <Window.Resources>

        <!-- ============================================================ -->
        <!-- BOUTONS DU MENU                                              -->
        <!-- ============================================================ -->

        <Style x:Key="MenuButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#9299A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1A1E27"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#222733"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- BOUTON PRINCIPAL                                             -->
        <!-- ============================================================ -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6675F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#7583FF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#5967DF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ============================================================ -->
        <!-- MENU                                                         -->
        <!-- ============================================================ -->

        <Border Grid.Column="0"
                Background="#12151C"
                BorderBrush="#20242E"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0">

                    <TextBlock Text="DashRL"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Rocket League Overlay"
                               Foreground="#737A89"
                               FontSize="11"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <StackPanel Grid.Row="2">

                    <Button x:Name="DashboardButton"
                            Content="Dashboard"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="DashboardButton_Click"/>

                    <Button x:Name="OverlayButton"
                            Content="Overlay"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="OverlayButton_Click"/>

                    <Button Content="Statistiques"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Content="Paramètres"
                            Style="{StaticResource MenuButtonStyle}"/>

                </StackPanel>


                <Border Grid.Row="3"
                        Background="#181C24"
                        CornerRadius="8"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="ROCKET LEAGUE"
                                   Foreground="#737A89"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ConnectionStatus"
                                   Text="● Connexion..."
                                   Foreground="#E5A93D"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ============================================================ -->
        <!-- CONTENU                                                      -->
        <!-- ============================================================ -->

        <Grid Grid.Column="1">


            <!-- ======================================================== -->
            <!-- PAGE DASHBOARD                                           -->
            <!-- ======================================================== -->

            <ScrollViewer x:Name="DashboardPage"
                          Visibility="Visible"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="35">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Dashboard"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Données Rocket League en temps réel"
                                   Foreground="#737A89"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- MATCH -->

                    <Border Grid.Row="2"
                            Background="#151820"
                            CornerRadius="12"
                            Padding="25">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock x:Name="BlueTeamName"
                                       Grid.Column="0"
                                       Text="BLEU"
                                       Foreground="#4A9EFF"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>


                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">

                                <TextBlock x:Name="ScoreText"
                                           Text="0 - 0"
                                           Foreground="White"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="TimeText"
                                           Text="00:00"
                                           Foreground="#8B92A1"
                                           FontSize="18"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>


                            <TextBlock x:Name="OrangeTeamName"
                                       Grid.Column="2"
                                       Text="ORANGE"
                                       Foreground="#FF8A3D"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- SESSION -->

                    <Border Grid.Row="4"
                            Background="#151820"
                            CornerRadius="12"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="SESSION"
                                       Foreground="#737A89"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>


                            <UniformGrid Columns="3">

                                <StackPanel>

                                    <TextBlock Text="VICTOIRES"
                                               Foreground="#737A89"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="SessionWins"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <StackPanel>

                                    <TextBlock Text="DÉFAITES"
                                               Foreground="#737A89"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="SessionLosses"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                </StackPanel>


                                <StackPanel>

                                    <TextBlock Text="STREAK"
                                               Foreground="#737A89"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="SessionStreak"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                            </UniformGrid>

                        </StackPanel>

                    </Border>


                    <!-- JOUEUR -->

                    <Border Grid.Row="6"
                            Background="#151820"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,0,0,35">

                        <StackPanel>

                            <TextBlock Text="JOUEUR CIBLÉ"
                                       Foreground="#737A89"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="PlayerName"
                                       Text="En attente..."
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,5,0,20"/>


                            <UniformGrid Columns="3">

                                <StackPanel Margin="10">
                                    <TextBlock Text="SCORE"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerScore"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="BUTS"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerGoals"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="TIRS"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerShots"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="PASSES"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerAssists"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="ARRÊTS"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerSaves"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Margin="10">
                                    <TextBlock Text="BOOST"
                                               Foreground="#737A89"
                                               FontSize="11"/>
                                    <TextBlock x:Name="PlayerBoost"
                                               Text="0%"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                </StackPanel>

                            </UniformGrid>

                        </StackPanel>

                    </Border>

                </Grid>

            </ScrollViewer>


            <!-- ======================================================== -->
            <!-- PAGE OVERLAY                                             -->
            <!-- ======================================================== -->

            <ScrollViewer x:Name="OverlayPage"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid Margin="35">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TITRE -->

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Overlay"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Configure l'overlay affiché pendant tes parties"
                                   Foreground="#737A89"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- APERÇU -->

                    <Border Grid.Row="2"
                            Background="#151820"
                            CornerRadius="12"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="APERÇU"
                                       Foreground="#737A89"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>


                            <Border Background="#0E1016"
                                    CornerRadius="12"
                                    Padding="40"
                                    MinHeight="180">

                                <Border Background="#E6101218"
                                        CornerRadius="14"
                                        BorderBrush="#303541"
                                        BorderThickness="1"
                                        Padding="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- SESSION -->

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="SESSION"
                                                       Foreground="#737A89"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,5,0,0">

                                                <TextBlock x:Name="PreviewWins"
                                                           Text="0 W"
                                                           Foreground="#72D69A"
                                                           FontSize="20"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="   "
                                                           FontSize="20"/>

                                                <TextBlock x:Name="PreviewLosses"
                                                           Text="0 L"
                                                           Foreground="#E87979"
                                                           FontSize="20"
                                                           FontWeight="Bold"/>

                                            </StackPanel>

                                        </StackPanel>


                                        <!-- SÉPARATEUR -->

                                        <Border Grid.Column="2"
                                                Width="1"
                                                Height="40"
                                                Background="#343A46"
                                                VerticalAlignment="Center"/>


                                        <!-- STREAK -->

                                        <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center">

                                            <TextBlock Text="STREAK"
                                                       Foreground="#737A89"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock x:Name="PreviewStreak"
                                                       Text="0"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Border>

                        </StackPanel>

                    </Border>


                    <!-- CONTRÔLES -->

                    <Border Grid.Row="4"
                            Background="#151820"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,0,0,35">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Overlay en jeu"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="OverlayStatusText"
                                           Text="L'overlay est actuellement désactivé"
                                           Foreground="#737A89"
                                           FontSize="12"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <Button x:Name="ToggleOverlayButton"
                                    Grid.Column="1"
                                    Content="Afficher l'overlay"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ToggleOverlayButton_Click"/>

                        </Grid>

                    </Border>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>