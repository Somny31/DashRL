<Window x:Class="DashRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashRL"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F14">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU GAUCHE -->

        <Border Grid.Column="0"
                Background="#12151C"
                BorderBrush="#20242E"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="DashRL"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Rocket League Overlay"
                               Foreground="#737A89"
                               FontSize="11"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <!-- NAVIGATION -->

                <StackPanel Grid.Row="2">

                    <Button Content="Dashboard"
                            Height="42"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button x:Name="OverlayButton"
                            Content="Overlay"
                            Height="42"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"
                            Click="OverlayButton_Click"/>

                    <Button Content="Statistiques"
                            Height="42"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                    <Button Content="Paramètres"
                            Height="42"
                            HorizontalContentAlignment="Left"
                            Padding="15,0"/>

                </StackPanel>

                <!-- CONNEXION -->

                <Border Grid.Row="3"
                        Background="#181C24"
                        CornerRadius="8"
                        Padding="12">

                    <StackPanel>

                        <TextBlock Text="ROCKET LEAGUE"
                                   Foreground="#737A89"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ConnectionStatus"
                                   Text="● Connexion..."
                                   Foreground="#E5A93D"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- CONTENU -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="35">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITRE -->

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Dashboard"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Données Rocket League en temps réel"
                               Foreground="#737A89"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- MATCH -->

                <Border Grid.Row="2"
                        Background="#151820"
                        CornerRadius="12"
                        Padding="25">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="BlueTeamName"
                                   Grid.Column="0"
                                   Text="BLEU"
                                   Foreground="#4A9EFF"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center">

                            <TextBlock x:Name="ScoreText"
                                       Text="0 - 0"
                                       Foreground="White"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TimeText"
                                       Text="00:00"
                                       Foreground="#8B92A1"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock x:Name="OrangeTeamName"
                                   Grid.Column="2"
                                   Text="ORANGE"
                                   Foreground="#FF8A3D"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <!-- SESSION -->

                <Border Grid.Row="4"
                        Background="#151820"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="SESSION"
                                   Foreground="#737A89"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <UniformGrid Columns="3">

                            <StackPanel>

                                <TextBlock Text="VICTOIRES"
                                           Foreground="#737A89"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="SessionWins"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <StackPanel>

                                <TextBlock Text="DÉFAITES"
                                           Foreground="#737A89"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="SessionLosses"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <StackPanel>

                                <TextBlock Text="STREAK"
                                           Foreground="#737A89"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>

                                <TextBlock x:Name="SessionStreak"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </UniformGrid>

                    </StackPanel>

                </Border>

                <!-- JOUEUR -->

                <Border Grid.Row="6"
                        Background="#151820"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,35">

                    <StackPanel>

                        <TextBlock Text="JOUEUR CIBLÉ"
                                   Foreground="#737A89"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="PlayerName"
                                   Text="En attente..."
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,5,0,20"/>

                        <UniformGrid Columns="3">

                            <StackPanel Margin="10">
                                <TextBlock Text="SCORE"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerScore"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="10">
                                <TextBlock Text="BUTS"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerGoals"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="10">
                                <TextBlock Text="TIRS"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerShots"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="10">
                                <TextBlock Text="PASSES"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerAssists"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="10">
                                <TextBlock Text="ARRÊTS"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerSaves"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Margin="10">
                                <TextBlock Text="BOOST"
                                           Foreground="#737A89"
                                           FontSize="11"/>
                                <TextBlock x:Name="PlayerBoost"
                                           Text="0%"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                            </StackPanel>

                        </UniformGrid>

                    </StackPanel>

                </Border>

            </Grid>

        </ScrollViewer>

    </Grid>

</Window>