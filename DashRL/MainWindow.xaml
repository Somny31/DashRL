                <TextBlock Text="STYLE"
                           Foreground="#737A89"
                           FontSize="11"
                           FontWeight="Bold"/>

                <TextBlock Text="Choisis un style de base"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,5,0,20"/>


                <UniformGrid Columns="4">


