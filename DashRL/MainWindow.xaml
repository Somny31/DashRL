                        <StackPanel>

                            <TextBlock Text="Competitive"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Style esport"
                                       Foreground="#737A89"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Button>


