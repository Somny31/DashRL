                                       FontSize="11"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Button>


                    <!-- COMPETITIVE -->

                    <Button x:Name="CompetitivePresetButton"
                            Style="{StaticResource PresetButtonStyle}"
