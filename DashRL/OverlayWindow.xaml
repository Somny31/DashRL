<Window x:Class="DashRL.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashRL Overlay"
        Width="650"
        Height="90"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="#E6101218"
            CornerRadius="14"
            BorderBrush="#303541"
            BorderThickness="1"
            Padding="18">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- RANK TEMPORAIRE -->

            <Border Grid.Column="0"
                    Width="52"
                    Height="52"
                    CornerRadius="10"
                    Background="#1D222C">

                <TextBlock Text="?"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <!-- MMR -->

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock Text="MMR"
                           Foreground="#737A89"
                           FontSize="10"/>

                <TextBlock x:Name="OverlayMmr"
                           Text="---"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

            </StackPanel>

            <!-- SÉPARATEUR -->

            <Border Grid.Column="4"
                    Width="1"
                    Height="35"
                    Background="#343A46"
                    VerticalAlignment="Center"/>

            <!-- W / L -->

            <StackPanel Grid.Column="6"
                        VerticalAlignment="Center">

                <TextBlock Text="SESSION"
                           Foreground="#737A89"
                           FontSize="10"/>

                <StackPanel Orientation="Horizontal">

                    <TextBlock x:Name="OverlayWins"
                               Text="0 W"
                               Foreground="#72D69A"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="  "
                               FontSize="18"/>

                    <TextBlock x:Name="OverlayLosses"
                               Text="0 L"
                               Foreground="#E87979"
                               FontSize="18"
                               FontWeight="Bold"/>

                </StackPanel>

            </StackPanel>

            <!-- SÉPARATEUR -->

            <Border Grid.Column="8"
                    Width="1"
                    Height="35"
                    Background="#343A46"
                    VerticalAlignment="Center"/>

            <!-- STREAK -->

            <StackPanel Grid.Column="10"
                        VerticalAlignment="Center">

                <TextBlock Text="STREAK"
                           Foreground="#737A89"
                           FontSize="10"/>

                <TextBlock x:Name="OverlayStreak"
                           Text="0"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>