<Window x:Class="DashRL.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DashRL Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        La fenêtre occupe maintenant tout l'écran Rocket League.
        OverlayPositionContainer permet de placer le vrai overlay
        précisément dans un coin ou au centre.
    -->

    <Grid x:Name="OverlayRoot"
          Background="Transparent">

        <Grid x:Name="OverlayPositionContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="15">

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OverlayScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1"/>
                    <TranslateTransform x:Name="OverlayPositionTransform"
                                        X="0"
                                        Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

                <!-- CUSTOM OVERLAY -->
                <Canvas x:Name="CustomOverlayCanvas"
                        Visibility="Collapsed"
                        Width="500"
                        Height="150"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"/>



            <!-- ================================================= -->
            <!-- MINIMAL -->
            <!-- ================================================= -->

            <Border x:Name="MinimalOverlay"
                    Background="#E6101218"
                    BorderBrush="#303541"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <StackPanel x:Name="MinimalWinsContainer"
                                Orientation="Horizontal">

                        <TextBlock x:Name="MinimalWins"
                                   Text="0 W"
                                   Foreground="#72D69A"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="   "
                                   FontSize="18"/>

                    </StackPanel>


                    <StackPanel x:Name="MinimalLossesContainer"
                                Orientation="Horizontal">

                        <TextBlock x:Name="MinimalLosses"
                                   Text="0 L"
                                   Foreground="#E87979"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                    </StackPanel>


                    <StackPanel x:Name="MinimalStreakContainer"
                                Orientation="Horizontal">

                        <Border Width="1"
                                Height="22"
                                Background="#3B414D"
                                Margin="18,0"/>

                        <TextBlock x:Name="MinimalStreak"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- COMPETITIVE -->
            <!-- ================================================= -->

            <Border x:Name="CompetitiveOverlay"
                    Visibility="Collapsed"
                    Background="#F012151D"
                    BorderBrush="#6675F5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="SESSION"
                               Foreground="#6675F5"
                               FontSize="9"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0">

                        <TextBlock x:Name="CompetitiveWins"
                                   Text="0 W"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="CompetitiveLosses"
                                   Text="0 L"
                                   Foreground="#8C93A3"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Margin="20,0,0,0"/>

                        <StackPanel x:Name="CompetitiveStreakContainer"
                                    Orientation="Horizontal">

                            <TextBlock Text="STREAK"
                                       Foreground="#737A89"
                                       FontSize="9"
                                       Margin="35,7,8,0"/>

                            <TextBlock x:Name="CompetitiveStreak"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- CARDS -->
            <!-- ================================================= -->

            <StackPanel x:Name="CardsOverlay"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border x:Name="CardsWinsContainer"
                        Background="#F0171B23"
                        BorderBrush="#343A47"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="25,13"
                        Margin="4">

                    <StackPanel>

                        <TextBlock Text="WINS"
                                   Foreground="#737A89"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CardsWins"
                                   Text="0"
                                   Foreground="#72D69A"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <Border x:Name="CardsLossesContainer"
                        Background="#F0171B23"
                        BorderBrush="#343A47"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="25,13"
                        Margin="4">

                    <StackPanel>

                        <TextBlock Text="LOSSES"
                                   Foreground="#737A89"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CardsLosses"
                                   Text="0"
                                   Foreground="#E87979"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <Border x:Name="CardsStreakContainer"
                        Background="#F0171B23"
                        BorderBrush="#343A47"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="25,13"
                        Margin="4">

                    <StackPanel>

                        <TextBlock Text="STREAK"
                                   Foreground="#737A89"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CardsStreak"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>


            <!-- ================================================= -->
            <!-- PILL -->
            <!-- ================================================= -->

            <Border x:Name="PillOverlay"
                    Visibility="Collapsed"
                    Background="#EE181C24"
                    BorderBrush="#343A46"
                    BorderThickness="1"
                    CornerRadius="25"
                    Padding="25,11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <StackPanel x:Name="PillWinsContainer"
                                Orientation="Horizontal">

                        <TextBlock Text="●"
                                   Foreground="#72D69A"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="PillWins"
                                   Text="0 W"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="7,0,20,0"/>

                    </StackPanel>


                    <StackPanel x:Name="PillLossesContainer"
                                Orientation="Horizontal">

                        <TextBlock Text="●"
                                   Foreground="#E87979"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="PillLosses"
                                   Text="0 L"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="7,0,20,0"/>

                    </StackPanel>


                    <StackPanel x:Name="PillStreakContainer"
                                Orientation="Horizontal">

                        <TextBlock Text="STREAK"
                                   Foreground="#737A89"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock x:Name="PillStreak"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>