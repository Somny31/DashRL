<Window x:Class="DashRL.CustomOverlayEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Overlay Editor"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C11"
        Foreground="#F1F2F5"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <!-- Boutons principaux -->
        <Style x:Key="EditorButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="#171A22"/>

            <Setter Property="Foreground"
                    Value="#E8EAF0"/>

            <Setter Property="BorderBrush"
                    Value="#292E39"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#20242E"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3A4050"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- Bouton violet -->
        <Style x:Key="PrimaryEditorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">

            <Setter Property="Background"
                    Value="#7164E8"/>

            <Setter Property="BorderBrush"
                    Value="#7164E8"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>


        <!-- Boutons d'ajout d'élément -->
        <Style x:Key="ElementButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="13,0"/>

        </Style>


        <!-- TextBox -->
        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="Foreground"
                    Value="#F1F2F5"/>

            <Setter Property="Background"
                    Value="#11141B"/>

            <Setter Property="BorderBrush"
                    Value="#292E39"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="LayerButtonStyle"
       TargetType="Button">

    <Setter Property="Height"
            Value="56"/>

    <Setter Property="MinWidth"
            Value="120"/>

    <Setter Property="Margin"
            Value="0,0,8,0"/>

    <Setter Property="Padding"
            Value="12,0"/>

    <Setter Property="Background"
            Value="#11141B"/>

    <Setter Property="Foreground"
            Value="#E8EAF0"/>

    <Setter Property="BorderBrush"
            Value="#292E39"/>

    <Setter Property="BorderThickness"
            Value="1"/>

    <Setter Property="Cursor"
            Value="Hand"/>

    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border
                    x:Name="LayerBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <ControlTemplate.Triggers>

                    <Trigger
                        Property="IsMouseOver"
                        Value="True">

                        <Setter
                            TargetName="LayerBorder"
                            Property="Background"
                            Value="#171A22"/>

                        <Setter
                            TargetName="LayerBorder"
                            Property="BorderBrush"
                            Value="#464D60"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>

    </Setter>

</Style>
    
        <!-- Scrollbar discrète pour la section CALQUES -->
        <Style x:Key="LayersScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Height="5"
                                CornerRadius="3"
                                Background="#343A48">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ThumbBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#596173"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ThumbBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#7C6CFF"
                                                            Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayersHorizontalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="16,0,16,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Height="7" Background="Transparent">
                            <Border Height="5"
                                    VerticalAlignment="Center"
                                    CornerRadius="3"
                                    Background="#151922"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False"
                                   Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LayersScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayersScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset,
                                                       RelativeSource={RelativeSource TemplatedParent},
                                                       Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{StaticResource LayersHorizontalScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="58"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Border Grid.Row="0"
                Background="#0D0F14"
                BorderBrush="#1D212B"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Custom Overlay Editor"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F1F2F5"/>

                    <TextBlock
                        Text="Create and customize your overlay"
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="#737A89"/>

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        x:Name="PreviewButton"
                        Content="Preview"
                        Width="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource EditorButtonStyle}"/>

                    <Button
                        x:Name="SaveButton"
                        Content="Save"
                        Width="90"
                        Style="{StaticResource PrimaryEditorButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- EDITOR -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="210"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="250"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- ELEMENTS -->
            <!-- ================================================== -->

            <Border Grid.Column="0"
                    Background="#0D0F14"
                    BorderBrush="#1D212B"
                    BorderThickness="0,0,1,0"
                    Padding="15">

                <StackPanel>

                    <TextBlock
                        Text="ELEMENTS"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="2,4,0,14"/>


                    <Button
                        x:Name="AddWinsButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#72D69A"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Wins"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddLossesButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#E87979"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Losses"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddStreakButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#A89CFF"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Streak"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddTextButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#AEB4C2"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Text"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddContainerButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#AEB4C2"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Container"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                        </Border>


            <!-- ================================================== -->
            <!-- CENTER : LAYERS + CANVAS -->
            <!-- ================================================== -->

            <Grid Grid.Column="1"
                  Background="#090B0F">

                <Grid.RowDefinitions>

                    <RowDefinition Height="42"/>

                    <RowDefinition Height="120"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


<!-- ================================================== -->
<!-- LAYERS HEADER -->
<!-- ================================================== -->

<Border
    Grid.Row="0"
    BorderBrush="#1D212B"
    BorderThickness="0,0,0,1">

    <Grid Margin="16,0">

        <TextBlock
            Text="CALQUES"
            Foreground="#737A89"
            FontSize="10"
            FontWeight="Bold"
            VerticalAlignment="Center"/>

    </Grid>

</Border>


<!-- ================================================== -->
<!-- LAYERS -->
<!-- ================================================== -->

<Border
    Grid.Row="1"
    Background="#0D0F14"
    BorderBrush="#1D212B"
    BorderThickness="0,0,0,1">

    <ScrollViewer
        Style="{StaticResource LayersScrollViewerStyle}"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Disabled"
        PanningMode="HorizontalOnly"
        CanContentScroll="False">

        <StackPanel
            x:Name="LayersPanel"
            Orientation="Horizontal"
            Margin="16,12,24,12"/>

    </ScrollViewer>

</Border>


<!-- ================================================== -->
<!-- CANVAS -->
<!-- ================================================== -->

                <Grid Grid.Row="2"
                      Background="#0A0C11">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <!--
                        Zone de travail façon Canva :
                        - sa taille ne dépend jamais du canvas
                        - elle masque tout ce qui dépasse
                        - le canvas conserve sa vraie taille logique
                        - seul son affichage est zoomé/dézoomé
                    -->
                    <Border Grid.Row="0"
                            Margin="24,20,24,12"
                            Background="#0F1218"
                            BorderBrush="#292E39"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <Grid x:Name="CanvasViewport"
                              Background="#0F1218"
                              SizeChanged="CanvasViewport_SizeChanged">

                            <ScrollViewer x:Name="CanvasScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="Both"
                                          Background="Transparent">

                                <Grid x:Name="CanvasCenterHost"
                                      Margin="48"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="CanvasScaleTransform"
                                                        ScaleX="1"
                                                        ScaleY="1"/>
                                    </Grid.LayoutTransform>

                                    <!-- Ombre/page -->
                                    <Border Background="#10131A"
                                            BorderBrush="#343A47"
                                            BorderThickness="1"
                                            CornerRadius="2">

                                        <Canvas x:Name="OverlayCanvas"
                                                Width="400"
                                                Height="150"
                                                Background="#08000000"/>

                                    </Border>

                                </Grid>

                            </ScrollViewer>

                        </Grid>

                    </Border>


                    <!-- Barre inférieure comme un éditeur graphique -->
                    <Border Grid.Row="1"
                            Background="#0D0F14"
                            BorderBrush="#1D212B"
                            BorderThickness="0,1,0,0">

                        <Grid Margin="18,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CanvasSizeText"
                                       Grid.Column="0"
                                       Text="400 × 150"
                                       Foreground="#737A89"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Button x:Name="CanvasZoomOutButton"
                                        Content="−"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,7,0"
                                        Background="#171A22"
                                        Foreground="#D8DBE2"
                                        BorderBrush="#303644"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="CanvasZoomOutButton_Click"/>

                                <Slider x:Name="CanvasZoomSlider"
                                        Width="145"
                                        Minimum="10"
                                        Maximum="200"
                                        Value="100"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        ValueChanged="CanvasZoomSlider_ValueChanged"/>

                                <TextBlock x:Name="CanvasZoomText"
                                           Width="46"
                                           Text="100%"
                                           Foreground="#AEB4C2"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="7,0,7,0"/>

                                <Button x:Name="CanvasZoomInButton"
                                        Content="+"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,7,0"
                                        Background="#171A22"
                                        Foreground="#D8DBE2"
                                        BorderBrush="#303644"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="CanvasZoomInButton_Click"/>

                                <Button x:Name="CanvasFitButton"
                                        Content="Fit"
                                        Height="28"
                                        Padding="11,0"
                                        Background="#171A22"
                                        Foreground="#D8DBE2"
                                        BorderBrush="#303644"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="CanvasFitButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>


            <!-- ================================================== -->
            <!-- PROPERTIES -->
            <!-- ================================================== -->

            <Border Grid.Column="2"
                    Background="#0D0F14"
                    BorderBrush="#1D212B"
                    BorderThickness="1,0,0,0"
                    Padding="17">

                <StackPanel>

                    <TextBlock
                        Text="PROPERTIES"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="0,4,0,18"/>


                    <TextBlock
                        x:Name="SelectedElementText"
                        Text="No element selected"
                        Foreground="#A0A6B3"
                        FontSize="12"
                        Margin="0,0,0,20"/>


                    <!-- CANVAS SIZE -->

                    <TextBlock
                        Text="Canvas size"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Width" Foreground="#555C6A" FontSize="9" Margin="1,0,0,4"/>
                            <TextBox x:Name="CanvasWidthTextBox" Text="500" LostFocus="CanvasSizeTextBox_LostFocus" KeyDown="CanvasSizeTextBox_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height" Foreground="#555C6A" FontSize="9" Margin="1,0,0,4"/>
                            <TextBox x:Name="CanvasHeightTextBox" Text="150" LostFocus="CanvasSizeTextBox_LostFocus" KeyDown="CanvasSizeTextBox_KeyDown"/>
                        </StackPanel>
                    </Grid>

                    <!-- POSITION -->

                    <TextBlock
                        Text="Position"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="X"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="PositionXTextBox"
                                Text="0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Y"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="PositionYTextBox"
                                Text="0"/>

                        </StackPanel>

                    </Grid>


                    <!-- SIZE -->

                    <TextBlock
                        Text="Size"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,18,0,8"/>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Width"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="WidthTextBox"
                                Text="100"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Height"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="HeightTextBox"
                                Text="40"/>

                        </StackPanel>

                    </Grid>


                    <!-- TEXT -->

                    <!-- TEXT -->

<StackPanel x:Name="TextPropertyPanel">

    <TextBlock
        Text="Text"
        Foreground="#737A89"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,18,0,8"/>

    <TextBox
        x:Name="ElementTextBox"
        Text=""/>

</StackPanel>


                    <!-- FONT SIZE -->

<StackPanel x:Name="FontSizePropertyPanel">

    <TextBlock
        Text="Font size"
        Foreground="#737A89"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,18,0,8"/>

    <TextBox
        x:Name="FontSizeTextBox"
        Text="18"/>

</StackPanel>


                    <!-- COLORS -->

                    <StackPanel x:Name="TextColorPropertyPanel">

                        <TextBlock
                            Text="Text color"
                            Foreground="#737A89"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,18,0,8"/>

                        <TextBox
                            x:Name="TextColorTextBox"
                            Text="#FFFFFF"
                            Margin="0,0,0,9"/>

                        <UniformGrid Columns="6"
                                     Margin="0,0,0,2">

                            <Button Tag="#FFFFFF"
                                    Height="25"
                                    Margin="2"
                                    Background="#FFFFFF"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="White"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#D7DBE4"
                                    Height="25"
                                    Margin="2"
                                    Background="#D7DBE4"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Light gray"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#8B93A5"
                                    Height="25"
                                    Margin="2"
                                    Background="#8B93A5"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Gray"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#11141B"
                                    Height="25"
                                    Margin="2"
                                    Background="#11141B"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Dark"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#72D69A"
                                    Height="25"
                                    Margin="2"
                                    Background="#72D69A"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Green"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#E87979"
                                    Height="25"
                                    Margin="2"
                                    Background="#E87979"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Red"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#A89CFF"
                                    Height="25"
                                    Margin="2"
                                    Background="#A89CFF"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Purple"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#7C6CFF"
                                    Height="25"
                                    Margin="2"
                                    Background="#7C6CFF"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="DashRL"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#5FB3FF"
                                    Height="25"
                                    Margin="2"
                                    Background="#5FB3FF"
                                    BorderBrush="#4A5060"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Blue"
                                    Click="TextColorPaletteButton_Click"/>

                            <Button Tag="#58D5D3"
                                    Height="25"
                                    Margin="2"
                                    Background="#58D5D3"
