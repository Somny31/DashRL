<Window x:Class="DashRL.CustomOverlayEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Overlay Editor"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C11"
        Foreground="#F1F2F5"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <!-- Boutons principaux -->
        <Style x:Key="EditorButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Background"
                    Value="#171A22"/>

            <Setter Property="Foreground"
                    Value="#E8EAF0"/>

            <Setter Property="BorderBrush"
                    Value="#292E39"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#20242E"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3A4050"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- Bouton violet -->
        <Style x:Key="PrimaryEditorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">

            <Setter Property="Background"
                    Value="#7164E8"/>

            <Setter Property="BorderBrush"
                    Value="#7164E8"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>


        <!-- Boutons d'ajout d'élément -->
        <Style x:Key="ElementButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="13,0"/>

        </Style>


        <!-- TextBox -->
        <Style TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="9,0"/>

            <Setter Property="Foreground"
                    Value="#F1F2F5"/>

            <Setter Property="Background"
                    Value="#11141B"/>

            <Setter Property="BorderBrush"
                    Value="#292E39"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="58"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- HEADER -->
        <!-- ====================================================== -->

        <Border Grid.Row="0"
                Background="#0D0F14"
                BorderBrush="#1D212B"
                BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Custom Overlay Editor"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F1F2F5"/>

                    <TextBlock
                        Text="Create and customize your overlay"
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="#737A89"/>

                </StackPanel>


                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        Content="Preview"
                        Width="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource EditorButtonStyle}"/>

                    <Button
                        Content="Save"
                        Width="90"
                        Style="{StaticResource PrimaryEditorButtonStyle}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- EDITOR -->
        <!-- ====================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="210"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="250"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- ELEMENTS -->
            <!-- ================================================== -->

            <Border Grid.Column="0"
                    Background="#0D0F14"
                    BorderBrush="#1D212B"
                    BorderThickness="0,0,1,0"
                    Padding="15">

                <StackPanel>

                    <TextBlock
                        Text="ELEMENTS"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="2,4,0,14"/>


                    <Button
                        x:Name="AddWinsButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#72D69A"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Wins"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddLossesButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#E87979"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Losses"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddStreakButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#A89CFF"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Streak"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddTextButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#AEB4C2"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Text"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button
                        x:Name="AddContainerButton"
                        Style="{StaticResource ElementButtonStyle}">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="+"
                                Foreground="#AEB4C2"
                                FontSize="17"
                                FontWeight="Bold"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                Text="Container"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>


            <!-- ================================================== -->
            <!-- CANVAS -->
            <!-- ================================================== -->

            <Grid Grid.Column="1"
                  Background="#090B0F">

                <Grid.RowDefinitions>

                    <RowDefinition Height="42"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <Border
                    Grid.Row="0"
                    BorderBrush="#1D212B"
                    BorderThickness="0,0,0,1">

                    <Grid Margin="16,0">

                        <TextBlock
                            Text="CANVAS"
                            Foreground="#737A89"
                            FontSize="10"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <Grid Grid.Row="1">

                    <!-- Fond de la zone de travail -->
                    <Border
                        Width="560"
                        Height="300"
                        Background="#0F1218"
                        BorderBrush="#292E39"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Grid>

                            <!--
                                Ce Canvas recevra les éléments
                                du Custom Overlay.
                            -->

                            <Canvas
                                x:Name="OverlayCanvas"
                                Width="500"
                                Height="150"
                                Background="#08000000"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <TextBlock
                        Text="500 × 150"
                        Foreground="#555C6A"
                        FontSize="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,205,0,0"/>

                </Grid>

            </Grid>


            <!-- ================================================== -->
            <!-- PROPERTIES -->
            <!-- ================================================== -->

            <Border Grid.Column="2"
                    Background="#0D0F14"
                    BorderBrush="#1D212B"
                    BorderThickness="1,0,0,0"
                    Padding="17">

                <StackPanel>

                    <TextBlock
                        Text="PROPERTIES"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="0,4,0,18"/>


                    <TextBlock
                        x:Name="SelectedElementText"
                        Text="No element selected"
                        Foreground="#A0A6B3"
                        FontSize="12"
                        Margin="0,0,0,20"/>


                    <!-- POSITION -->

                    <TextBlock
                        Text="Position"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="X"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="PositionXTextBox"
                                Text="0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Y"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="PositionYTextBox"
                                Text="0"/>

                        </StackPanel>

                    </Grid>


                    <!-- SIZE -->

                    <TextBlock
                        Text="Size"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,18,0,8"/>


                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Width"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="WidthTextBox"
                                Text="100"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Height"
                                Foreground="#555C6A"
                                FontSize="9"
                                Margin="1,0,0,4"/>

                            <TextBox
                                x:Name="HeightTextBox"
                                Text="40"/>

                        </StackPanel>

                    </Grid>


                    <!-- TEXT -->

                    <!-- TEXT -->

<StackPanel x:Name="TextPropertyPanel">

    <TextBlock
        Text="Text"
        Foreground="#737A89"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,18,0,8"/>

    <TextBox
        x:Name="ElementTextBox"
        Text=""/>

</StackPanel>


                    <!-- FONT SIZE -->

<StackPanel x:Name="FontSizePropertyPanel">

    <TextBlock
        Text="Font size"
        Foreground="#737A89"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,18,0,8"/>

    <TextBox
        x:Name="FontSizeTextBox"
        Text="18"/>

</StackPanel>


                    <!-- COLORS -->

                    <StackPanel x:Name="TextColorPropertyPanel">

    <TextBlock
        Text="Text color"
        Foreground="#737A89"
        FontSize="10"
        FontWeight="SemiBold"
        Margin="0,18,0,8"/>

    <TextBox
        x:Name="TextColorTextBox"
        Text="#FFFFFF"/>

</StackPanel>


                    <TextBlock
                        Text="Background"
                        Foreground="#737A89"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,18,0,8"/>

                    <TextBox
                        x:Name="BackgroundColorTextBox"
                        Text="#00000000"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>